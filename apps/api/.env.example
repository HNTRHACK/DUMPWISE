# Copy to apps/api/.env and replace every <...> placeholder. Never commit the real file.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# Restricted runtime role (created by scripts/setup-db-roles.ts)
APP_DB_USER=dumpwise_app
APP_DB_PASSWORD=<generate-a-random-password>
DATABASE_URL=postgresql://dumpwise_app:<APP_DB_PASSWORD>@127.0.0.1:5433/dumpwise_dev?schema=public

# Admin role, used ONLY by Prisma migrations and the role-setup script
MIGRATION_DATABASE_URL=postgresql://dumpwise:<POSTGRES_PASSWORD>@127.0.0.1:5433/dumpwise_dev?schema=public

# Legacy test URLs (test:e2e now creates a fresh database and roles automatically)
TEST_DATABASE_URL=postgresql://dumpwise_app:<APP_DB_PASSWORD>@127.0.0.1:5433/dumpwise_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://dumpwise:<POSTGRES_PASSWORD>@127.0.0.1:5433/dumpwise_test?schema=public

# Operator provisioning role: used ONLY by the CLI (create users, grant memberships, reset
# passwords, cleanup). Never give this to the API process.
PROVISIONER_DB_USER=dumpwise_provisioner
PROVISIONER_DB_PASSWORD=<generate-a-random-password>
PROVISIONER_DATABASE_URL=postgresql://dumpwise_provisioner:<PROVISIONER_DB_PASSWORD>@127.0.0.1:5433/dumpwise_dev?schema=public
TEST_PROVISIONER_DATABASE_URL=postgresql://dumpwise_provisioner:<PROVISIONER_DB_PASSWORD>@127.0.0.1:5433/dumpwise_test?schema=public

# Import limits
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=200000

# Authentication (defaults shown; all optional)
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900        # 15 min access tokens
# AUTH_SESSION_TTL_SECONDS=604800          # sessions end after 7 days, refresh cannot extend this
# AUTH_MAX_FAILED_LOGINS=5                 # password-change verification failures before lockout
# AUTH_LOCKOUT_SECONDS=900

# Rate limits per client IP per minute (defaults shown)
# RATE_LIMIT_AUTH_PER_MINUTE=10            # login, refresh, change-password
# RATE_LIMIT_DEFAULT_PER_MINUTE=300        # everything else

# Swagger UI at /docs (defaults to on outside production)
# ENABLE_API_DOCS=true

# Persistent login failures (account/IP, whole IP, distributed account protection)
# AUTH_MAX_SESSIONS_PER_USER=10
# LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=5
# LOGIN_ACCOUNT_IP_BLOCK_SECONDS=900
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_IP_BLOCK_SECONDS=3600
# LOGIN_MAX_FAILURES_PER_ACCOUNT=20
# LOGIN_ACCOUNT_PROTECT_SECONDS=3600

# Operator-only npm run auth:cleanup (schedule externally; never give API DELETE grants)
# AUTH_CLEANUP_RETENTION_DAYS=7
# AUTH_CLEANUP_BATCH_SIZE=1000
