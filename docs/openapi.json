  "info": {
    "title": "DUMPWISE API",
    "description": "Authenticate with POST /v1/auth/login, then send \"Authorization: Bearer <accessToken>\". Organization-scoped endpoints also require the X-Organization-Id header.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Opaque access token (dwa_…)"
      }
    },
    "schemas": {
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "database"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "dumpwise-api"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-23T10:00:00.000Z",
            "format": "date-time"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "service",
          "timestamp",
          "checks"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo.analyst@example.invalid"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
