    "/v1/imports": {
      "post": {
        "description": "201 when a new batch record was created (check `outcome`: IMPORTED, FAILED_VALIDATION or RECONCILIATION_FAILED). 200 with outcome ALREADY_IMPORTED when this exact file was imported before.",
        "operationId": "ImportsController_upload",
        "parameters": [
          {
            "name": "X-Organization-Id",
            "in": "header",
            "description": "Organization UUID the caller is a member of",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file",
                  "controlTotals"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "SAP billing export (CSV, UTF-8)"
                  },
                  "controlTotals": {
                    "type": "string",
                    "format": "binary",
                    "description": "Control totals JSON (expected monthly totals)"
                  },
                  "numberFormat": {
                    "type": "string",
                    "enum": [
                      "PLAIN",
                      "EN_GROUPED"
                    ],
                    "default": "PLAIN"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ALREADY_IMPORTED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResultDto"
                }
              }
            }
          },
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportResultDto"
                }
              }
            }
          },
          "400": {
            "description": "Missing file parts, oversized upload, or control totals not valid JSON"
          },
          "401": {
            "description": "Missing, expired or revoked access token"
          },
          "403": {
            "description": "Not a member, or role not allowed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Upload an SAP billing CSV with its control totals and run the import pipeline",
        "tags": [
          "imports"
        ]
      },
      "get": {
        "operationId": "ImportsController_list",
        "parameters": [
          {
            "name": "X-Organization-Id",
            "in": "header",
            "description": "Organization UUID the caller is a member of",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "offset",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 0,
              "maximum": 10000,
              "default": 0,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportBatchListDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked access token"
          },
          "403": {
            "description": "Not a member, or role not allowed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "List import batches of the organization (newest first)",
        "tags": [
          "imports"
        ]
      }
    },
